#!/usr/bin/env zsh
# Measures Photon's cold start (launch -> first frame), idle memory (macOS physical footprint, the
# number Activity Monitor shows) and idle CPU, and compares them with the committed baseline.
#
# A second run opens tooling/photon-perf/sample/diagram.excalidraw, which starts the Excalidraw web view,
# and reports RSS and idle CPU of Photon plus its WebKit helper processes (WebContent, Networking, GPU).
# Those are launched by launchd, so they are found by their "responsible process"
# (tooling/photon-perf/responsible.py): those that share Photon's responsible process, started no earlier than
# Photon and did not exist before the run. Remaining limit: a WebKit client started from the same GUI ancestor
# during the run (another app, another Photon launched from this terminal) still matches.
# Idle CPU there must also be under 1%; it is not compared with a baseline.
#
# The sample project opens with one block terminal at a zsh prompt, in a focused window. Idle CPU covers
# the whole process tree (app plus shells) over 10 s after 8 s of settling, past the 5 s after which the
# focused cursor stops blinking. Footprint is the app process only; the zsh Tab-completion helper (two
# extra zsh processes per terminal, spawned on the first Tab) is not started.
#
#   script/photon-perf                       # build release, measure, compare (10% threshold)
#   script/photon-perf --threshold 20        # looser threshold (CI)
#   script/photon-perf --update-baseline     # write the medians to the baseline file
#   script/photon-perf --binary PATH --no-build
set -euo pipefail
zmodload zsh/datetime zsh/mathfunc
cd "$(dirname "$0")/.."

binary=target/release/zed
threshold=10
update_baseline=0
build=1
runs=5
baseline=tooling/photon-perf/baseline.json
budget_footprint_mb=200
budget_start_ms=400 # a focused app launched through LaunchServices (`open`), ~365 ms
budget_idle_cpu_percent=1

while (( $# )); do
  case $1 in
    --threshold) threshold=$2; shift 2 ;;
    --update-baseline) update_baseline=1; shift ;;
    --binary) binary=$2; shift 2 ;;
    --no-build) build=0; shift ;;
    --runs) runs=$2; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

(( build )) && cargo build --release -p zed -p cli

median() { print -l -- "$@" | sort -n | awk '{ values[NR] = $1 } END { print values[int((NR + 1) / 2)] }'; }

descendants() {
  local pid=$1 child
  echo $pid
  for child in $(pgrep -P $pid 2>/dev/null); do descendants $child; done
}

# CPU seconds used so far by the process and its descendants (ps prints [[h:]m:]s.cc).
tree_cpu_seconds() {
  ps -o time= -p "$(descendants $1 | paste -sd, -)" \
    | awk -F: '{ seconds = 0; for (i = 1; i <= NF; i++) seconds = seconds * 60 + $i; total += seconds }
               END { printf "%.2f", total }'
}

# With a root pid, only processes that started after the root; without, a pre-launch baseline.
webkit_pids() { /usr/bin/python3 -I tooling/photon-perf/responsible.py webkit $responsible_pid ${1:-}; }

source tooling/photon-perf/launch-as-app.zsh
measure_dir=""
# The app is not a child of this shell, so it is waited for by polling.
stop_app() {
  kill $1 2>/dev/null || true
  while kill -0 $1 2>/dev/null; do sleep 0.1; done
}

start_times=()
footprint_values=()
cpu_values=()
for (( run = 1; run <= runs; run++ )); do
  scratch=$(mktemp -d)
  # A fresh data dir has no trust decisions, so Photon would open its "Trust this folder?" dialog,
  # which takes focus (and a diagram tab only starts its web view when focused). Trust the sample.
  mkdir -p "$scratch/data/config" && print -r -- '{ "session": { "trust_all_worktrees": true } }' >"$scratch/data/config/settings.json"
  # The terminal's zsh would otherwise run the user's rc files, whose prompt workers are not Photon's.
  mkdir "$scratch/zdotdir"
  export ZDOTDIR="$scratch/zdotdir"
  launched_ms=$(( int(EPOCHREALTIME * 1000) ))
  launch_as_app "$binary" "$scratch/stderr.log" PHOTON_PERF=1 ZDOTDIR="$scratch/zdotdir" \
    -- --user-data-dir "$scratch/data" "$PWD/tooling/photon-perf/sample" || exit 2
  pid=$app_pid
  first_frame_ms=""
  for (( wait = 0; wait < 100; wait++ )); do
    first_frame_ms=$(awk '/photon-perf first-frame-epoch-ms/ { print $3; exit }' "$scratch/stderr.log")
    [[ -n $first_frame_ms ]] && break
    sleep 0.1
  done
  if [[ -z $first_frame_ms ]]; then
    kill $pid 2>/dev/null || true
    echo "no first frame within 10s; see $scratch/stderr.log" >&2
    exit 2
  fi
  sleep 8
  if ! ps -o comm= -p "$(descendants $pid | paste -sd, -)" | grep -q zsh; then
    kill $pid 2>/dev/null || true
    echo "no terminal shell under pid $pid; see $scratch/stderr.log" >&2
    exit 2
  fi
  cpu_before=$(tree_cpu_seconds $pid)
  sleep 10
  cpu_after=$(tree_cpu_seconds $pid)
  footprint_bytes=$(footprint -p $pid -f bytes | awk '/phys_footprint:/ { print $2; exit }')
  if [[ ! $footprint_bytes == <-> ]]; then
    kill $pid 2>/dev/null || true
    echo "could not read phys_footprint for pid $pid (is the footprint tool available?)" >&2
    exit 2
  fi
  stop_app $pid
  start_times+=($(( first_frame_ms - launched_ms )))
  footprint_values+=($(( footprint_bytes / 1048576 )))
  cpu_values+=($(printf '%.2f' $(( (cpu_after - cpu_before) * 100.0 / 10 ))))
  echo "run $run: cold start ${start_times[-1]} ms, idle footprint ${footprint_values[-1]} MB, idle CPU ${cpu_values[-1]}%"
done

start_ms=$(median "${start_times[@]}")
footprint_mb=$(median "${footprint_values[@]}")
cpu_percent=$(median "${cpu_values[@]}")
echo "median: cold start ${start_ms} ms, idle footprint ${footprint_mb} MB, idle CPU ${cpu_percent}%"

if (( update_baseline )); then
  machine="$(sysctl -n machdep.cpu.brand_string), $(( $(sysctl -n hw.memsize) / 1073741824 )) GB"
  printf '{\n  "idle_footprint_mb": %d,\n  "cold_start_ms": %d,\n  "idle_cpu_percent": %s,\n  "measured_on": "%s",\n  "date": "%s"\n}\n' \
    "$footprint_mb" "$start_ms" "$cpu_percent" "$machine" "$(date +%F)" > "$baseline"
  echo "baseline written to $baseline"
fi

# Diagram open: Photon plus WebKit.
# A process that exited between samples counts as 0.
cpu_seconds() {
  { ps -o time= -p "$1" 2>/dev/null || true; } \
    | awk -F: '{ s = 0; for (i = 1; i <= NF; i++) s = s * 60 + $i; t += s } END { printf "%.2f", t }'
}
rss_mb() { { ps -o rss= -p "$1" 2>/dev/null || true; } | awk '{ t += $1 } END { printf "%d", t / 1024 }'; }

responsible_pid=$(/usr/bin/python3 -I tooling/photon-perf/responsible.py owner $$) \
  || { echo "could not determine the responsible process of this script" >&2; exit 2; }
preexisting_webkit=" $(webkit_pids | paste -sd' ' -) "
scratch=$(mktemp -d)
# A fresh data dir has no trust decisions, so Photon would open its "Trust this folder?" dialog,
# which takes focus (and a diagram tab only starts its web view when focused). Trust the sample.
mkdir -p "$scratch/data/config" && print -r -- '{ "session": { "trust_all_worktrees": true } }' >"$scratch/data/config/settings.json"
pid=""
cleanup() {
  [[ -n $pid ]] && kill $(descendants $pid) 2>/dev/null || true
  [[ -n $measure_dir ]] && rm -rf "$measure_dir"
  rm -rf "$scratch"
}
trap cleanup EXIT
mkdir "$scratch/zdotdir"
launch_as_app "$binary" "$scratch/stderr.log" ZDOTDIR="$scratch/zdotdir" \
  -- --user-data-dir "$scratch/data" "$PWD/tooling/photon-perf/sample" "$PWD/tooling/photon-perf/sample/diagram.excalidraw" || exit 2
pid=$app_pid
# Launched by launchd, the app is its own responsible process.
responsible_pid=$(/usr/bin/python3 -I tooling/photon-perf/responsible.py owner $pid)
sleep 15
new_webkit_pids() {
  local found=() candidate
  for candidate in $(webkit_pids $pid); do [[ $preexisting_webkit == *" $candidate "* ]] || found+=($candidate); done
  (( ${#found} )) && print -l -- $found
  return 0
}
webkit=($(new_webkit_pids))
if (( ${#webkit} == 0 )); then
  echo "no WebKit processes found for the diagram run; see $scratch/stderr.log" >&2
  exit 2
fi
# The same pids are sampled before and after the window.
sampled_pids=$({ descendants $pid; print -l -- $webkit; } | paste -sd, -)
cpu_before=$(cpu_seconds "$sampled_pids")
sleep 10
cpu_after=$(cpu_seconds "$sampled_pids")
photon_rss_mb=$(rss_mb $pid)
webkit_rss_mb=$(rss_mb "${(j:,:)webkit}")
diagram_cpu=$(printf '%.2f' $(( (cpu_after - cpu_before) * 100.0 / 10 )))
echo "diagram open: RSS Photon ${photon_rss_mb} MB + ${#webkit} WebKit processes ${webkit_rss_mb} MB, idle CPU (Photon tree + WebKit) ${diagram_cpu}%"

failed=0
(( diagram_cpu >= budget_idle_cpu_percent )) && { echo "FAIL: diagram-open idle CPU ${diagram_cpu}% is not under ${budget_idle_cpu_percent}%"; failed=1; }
(( footprint_mb > budget_footprint_mb )) && { echo "FAIL: idle footprint ${footprint_mb} MB exceeds budget ${budget_footprint_mb} MB"; failed=1; }
(( start_ms > budget_start_ms )) && { echo "FAIL: cold start ${start_ms} ms exceeds budget ${budget_start_ms} ms"; failed=1; }
# A budget, not a baseline comparison: near 0%, a relative change is noise.
(( cpu_percent >= budget_idle_cpu_percent )) && { echo "FAIL: idle CPU ${cpu_percent}% is not under ${budget_idle_cpu_percent}%"; failed=1; }
if [[ -f $baseline ]] && (( ! update_baseline )); then
  base_footprint=$(awk -F'[:,]' '/idle_footprint_mb/ { print $2 + 0 }' "$baseline")
  base_start=$(awk -F'[:,]' '/cold_start_ms/ { print $2 + 0 }' "$baseline")
  (( footprint_mb * 100 > base_footprint * (100 + threshold) )) && { echo "FAIL: idle footprint regressed >${threshold}% (baseline ${base_footprint} MB)"; failed=1; }
  (( start_ms * 100 > base_start * (100 + threshold) )) && { echo "FAIL: cold start regressed >${threshold}% (baseline ${base_start} ms)"; failed=1; }
fi
(( failed )) && exit 1
echo "OK"
